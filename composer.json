{
    "name": "wpswings/woo-gift-cards-lite",
    "description": "Gift Cards for WooCommerce - Lite Version",
    "type": "wordpress-plugin",
    "require": {
        "php": ">=7.4"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.5",
        "mockery/mockery": "^1.5",
        "yoast/phpunit-polyfills": "^1.0"
    },
    "autoload-dev": {
        "psr-4": {
            "WooGiftCardsLite\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "test:coverage": "phpunit --coverage-html coverage"
    },
    "config": {
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
